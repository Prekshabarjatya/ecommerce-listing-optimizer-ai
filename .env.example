# Copy this file to .env and fill in your own key. Used both for running
# scripts locally and by `docker compose up` (see docker-compose.yml,
# Stage 9) -- compose reads .env from the project root automatically.
GROQ_API_KEY=

# Optional. Model used by audit_agent and content_agent. Defaults to
# openai/gpt-oss-120b if unset.
GROQ_MODEL=

# Optional. Model used by critic_agent. Defaults to GROQ_MODEL if unset --
# set this to a *different* model to reduce the self-correlation bias of
# the same model grading its own output. See docs/evaluation.md.
GROQ_CRITIC_MODEL=

# Optional. Postgres connection string (see app/database/schema.py, Stage
# 9). Not needed for `docker compose up` -- it sets this itself, pointing
# at the `db` service. Only set this yourself for running scripts/*.py or
# app/api.py against a different Postgres than the DEFAULT_DATABASE_URL in
# app/database/db.py (e.g. Render's database, for a one-off migration).
DATABASE_URL=
